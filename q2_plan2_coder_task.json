{
  "task": "coder_implementation",
  "sub_question": {
    "index": 1,
    "total": 4,
    "text": "问题2：按BMI分组给出每组最佳NIPT时点，使潜在风险最小，并分析检测误差对结果的影响。"
  },
  "plan": "plan_2_bayesian_monotone_beta_mixed",
  "decision_revision": "R3+R4（不允许降级；右删失处理；固定边界30.0；t_p0.80主交付）",
  "dynamic_ltm": {
    "objective": "贝叶斯单调Beta混合后验决策：组推荐=组内个体t_p0.80后验中位数+95%可信区间；与plan_1对比效果",
    "key_formulas": [
      "y_ij~Beta(mu_ij,phi); logit(mu_ij)=b0+b_ga(ga-10)+b_bmi*bmi+b_age*age+b_ivf*ivf+b0i+b1i(ga-10)",
      "b_ga~TruncNorm(0,inf); t_p0.80(b)=inf{t in [10,25]: P_marg(t,b)>=0.80}; 右删失t_p=25.0",
      "r_delay(t)=(t-10)/17; L_ref=r_delay+rho[1-P_marg], rho=1"
    ]
  },
